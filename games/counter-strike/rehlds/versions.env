# Pinned versions and download URLs for the CS 1.6 ReHLDS server stack.
# Verified 2026-07-28 (archive layouts were checked, not just the URLs).
# Every value can be overridden from the environment before running install.sh.

REHLDS_VERSION="${REHLDS_VERSION:-3.15.0.896}"
REGAMEDLL_VERSION="${REGAMEDLL_VERSION:-5.30.0.814}"
METAMOD_VERSION="${METAMOD_VERSION:-1.3.0.149}"
REAPI_VERSION="${REAPI_VERSION:-5.29.0.358}"
REUNION_VERSION="${REUNION_VERSION:-0.2.0.25}"
AMXX_VERSION="${AMXX_VERSION:-1.10.0-git5256}"

# ReHLDS      -> bin/linux32/engine_i486.so
REHLDS_URL="${REHLDS_URL:-https://github.com/rehlds/ReHLDS/releases/download/${REHLDS_VERSION}/rehlds-bin-${REHLDS_VERSION}.zip}"
# ReGameDLL   -> bin/linux32/cstrike/{dlls/cs.so,game.cfg,game_init.cfg,delta.lst}
REGAMEDLL_URL="${REGAMEDLL_URL:-https://github.com/rehlds/ReGameDLL_CS/releases/download/${REGAMEDLL_VERSION}/regamedll-bin-${REGAMEDLL_VERSION}.zip}"
# zBot data (BotProfile.db, BotChatter.db, bot radio voices) — lives in the repo, not in releases
BOT_PROFILES_URL="${BOT_PROFILES_URL:-https://raw.githubusercontent.com/rehlds/ReGameDLL_CS/master/regamedll/extra/zBot/bot_profiles.zip}"
# Metamod-R   -> addons/metamod/metamod_i386.so
METAMOD_URL="${METAMOD_URL:-https://github.com/rehlds/Metamod-R/releases/download/${METAMOD_VERSION}/metamod-bin-${METAMOD_VERSION}.zip}"
# ReAPI       -> addons/amxmodx/modules/reapi_amxx_i386.so (an AMXX module, not a
#                Metamod plugin) + scripting includes
REAPI_URL="${REAPI_URL:-https://github.com/rehlds/ReAPI/releases/download/${REAPI_VERSION}/reapi-bin-${REAPI_VERSION}.zip}"
# ReUnion     -> bin/Linux/reunion_mm_i386.so + reunion.cfg
REUNION_URL="${REUNION_URL:-https://github.com/rehlds/ReUnion/releases/download/${REUNION_VERSION}/reunion-${REUNION_VERSION}.zip}"
# AMX Mod X   -> addons/amxmodx/...
AMXX_BASE_URL="${AMXX_BASE_URL:-https://www.amxmodx.org/amxxdrop/1.10/amxmodx-${AMXX_VERSION}-base-linux.tar.gz}"
AMXX_CSTRIKE_URL="${AMXX_CSTRIKE_URL:-https://www.amxmodx.org/amxxdrop/1.10/amxmodx-${AMXX_VERSION}-cstrike-linux.tar.gz}"

# GPG key that signs the ReHLDS and ReGameDLL release archives.
REHLDS_GPG_KEY="${REHLDS_GPG_KEY:-63547829004F07716F7BE4856C32C4282E60FB67}"

# SteamCMD app 90 must come from the steam_legacy branch: ReHLDS only supports
# the pre-anniversary engine (build <= 8684).
STEAM_APP_BRANCH="${STEAM_APP_BRANCH:-steam_legacy}"

# Expected app 90 build on that branch. steam_legacy is a frozen snapshot
# ("Pre-25th Anniversary Build", last built 2020-08-19), so this pin is stable;
# it exists to catch a GAME_SRC that points at the wrong files. Check upstream
# with:
#   steamcmd +login anonymous +app_info_update 1 +app_info_print 90 +quit
GAME_BUILDID="${GAME_BUILDID:-5433925}"
STEAMCMD_URL="${STEAMCMD_URL:-https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz}"
